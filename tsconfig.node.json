{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        /* 🎯 ДОБАВЛЯЕМ СЮДА: разрешаем служебным файлам сборщика */
        /* использовать плагины на чистом JS без встроенных типов */
        "noImplicitAny": false
    },
    "include": [
        "vite.config.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.stories.*"
    ]
}
